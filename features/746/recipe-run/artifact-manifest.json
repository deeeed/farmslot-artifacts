{
  "version": 1,
  "runStatus": "fail",
  "artifacts": [
    {
      "path": "recipe.json",
      "type": "recipe",
      "label": "Executed recipe",
      "category": "system"
    },
    {
      "path": "recipe-invocation.json",
      "type": "json",
      "label": "Executed recipe parameters",
      "category": "system"
    },
    {
      "path": "recipe-resolution.json",
      "type": "json",
      "label": "Resolved recipe dependency graph",
      "category": "system"
    },
    {
      "path": "summary.json",
      "type": "summary",
      "label": "Run summary",
      "category": "system"
    },
    {
      "path": "trace.json",
      "type": "trace",
      "label": "Execution trace",
      "category": "system"
    },
    {
      "path": "videos/recipe-run.mp4",
      "type": "video",
      "mimeType": "video/mp4",
      "category": "proof",
      "label": "Recipe run video",
      "record": "full_run",
      "recorder": {
        "name": "capture-helper",
        "version": "0.2.6",
        "platform": "macos",
        "target": {
          "selector": "window-id",
          "value": "6125"
        }
      },
      "maxFps": 15
    }
  ]
}
